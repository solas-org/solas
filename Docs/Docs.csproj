<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <RootNamespace>Solas.Docs</RootNamespace>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Authors>solas-org</Authors>
        <Description>A high-performance, open-source game engine for .NET, created with love and a focus on developer experience</Description>
        <RepositoryUrl>https://github.com/solas-org/solas</RepositoryUrl>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Core/Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <Content Include="Scripts\Introduction\Console.csproj" />
    </ItemGroup>

</Project>
